nano .gitignore# ==================================================
# Centinela 503
# Python / FastAPI / ESP32 / Machine Learning
# ==================================================

# ------------------------------
# Python
# ------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Entornos virtuales
.venv/
venv/
env/
ENV/

# ------------------------------
# Variables de entorno / secretos
# ------------------------------
.env
.env.*
!.env.example

# ------------------------------
# Base de datos
# ------------------------------
*.db
*.sqlite
*.sqlite3
backend/data/*
!backend/data/.gitkeep

# ------------------------------
# Machine Learning
# ------------------------------
backend/app/ml/artifacts/*
!backend/app/ml/artifacts/.gitkeep

*.pkl
*.pickle
*.joblib

# ------------------------------
# Logs
# ------------------------------
*.log
logs/

# ------------------------------
# Testing / coverage
# ------------------------------
.pytest_cache/
.coverage
htmlcov/
.coverage.*

# ------------------------------
# Linters / type checking
# ------------------------------
.mypy_cache/
.ruff_cache/

# ------------------------------
# IDE / editores
# ------------------------------
.vscode/
.idea/
*.swp
*.swo

# ------------------------------
# Sistema operativo
# ------------------------------
.DS_Store
Thumbs.db

# ------------------------------
# Archivos temporales
# ------------------------------
*.tmp
*.temp
*.bak
*~
