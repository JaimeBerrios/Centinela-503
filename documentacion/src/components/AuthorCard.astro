---
interface Props {
  username?: string;
  role?: string;
  bio?: string;
}

const {
  username = 'JaimeBerrios',
  role = 'Estudiante de Ingeniería en Sistemas',
  bio = 'Creador de contenido sobre programación y proyectos IoT',
} = Astro.props;

const displayName = 'Jaime Berrios';
const githubUrl = `https://github.com/${username}`;

let avatarUrl = `https://github.com/${username}.png`;
let publicRepos = 0;

try {
  const response = await fetch(`https://api.github.com/users/${username}`);

  if (response.ok) {
    const user = await response.json();
    avatarUrl = user.avatar_url ?? avatarUrl;
    publicRepos = user.public_repos ?? publicRepos;
  }
} catch {
  // Keep fallback values when GitHub is unavailable during build/render.
}
---

<article class="author-card">
  <img
    class="author-card__avatar"
    src={avatarUrl}
    alt={`Foto de perfil de ${displayName}`}
    width="112"
    height="112"
    loading="lazy"
  />

  <div class="author-card__content">
    <p class="author-card__eyebrow">Autor</p>
    <h2 class="author-card__name">{displayName}</h2>
    <p class="author-card__role">{role}</p>
    <p class="author-card__bio">{bio}</p>

    <a class="author-card__button" href={githubUrl} target="_blank" rel="noreferrer">
      Ver mis {publicRepos} proyectos en GitHub
    </a>
  </div>
</article>

<style>
  .author-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    align-items: center;
    max-width: 46rem;
    padding: 1.5rem;
    border: 1px solid rgba(96, 165, 250, 0.24);
    border-radius: 1rem;
    color: #e6f1ff;
    background:
      linear-gradient(135deg, rgba(30, 64, 175, 0.24), rgba(15, 23, 42, 0.92)),
      #07111f;
    box-shadow: 0 24px 70px rgba(2, 8, 23, 0.42);
  }

  .author-card__avatar {
    width: 7rem;
    height: 7rem;
    border: 3px solid rgba(147, 197, 253, 0.8);
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 8px rgba(30, 64, 175, 0.18);
  }

  .author-card__content {
    min-width: 0;
  }

  .author-card__eyebrow {
    margin: 0 0 0.25rem;
    color: #93c5fd;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .author-card__name {
    margin: 0;
    color: #f8fbff;
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    line-height: 1.1;
  }

  .author-card__role {
    margin: 0.35rem 0 0;
    color: #bfdbfe;
    font-weight: 600;
  }

  .author-card__bio {
    margin: 0.75rem 0 1.15rem;
    color: #cbd5e1;
    line-height: 1.6;
  }

  .author-card__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.7rem 1rem;
    border: 1px solid rgba(147, 197, 253, 0.42);
    border-radius: 0.7rem;
    color: #07111f;
    background: linear-gradient(135deg, #93c5fd, #38bdf8);
    box-shadow: 0 12px 30px rgba(56, 189, 248, 0.22);
    font-weight: 800;
    text-decoration: none;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      filter 160ms ease;
  }

  .author-card__button:hover,
  .author-card__button:focus-visible {
    transform: translateY(-1px);
    box-shadow: 0 16px 36px rgba(56, 189, 248, 0.3);
    filter: brightness(1.05);
  }

  .author-card__button:focus-visible {
    outline: 3px solid rgba(147, 197, 253, 0.45);
    outline-offset: 3px;
  }

  @media (max-width: 42rem) {
    .author-card {
      grid-template-columns: 1fr;
      justify-items: start;
      padding: 1.25rem;
    }

    .author-card__avatar {
      width: 5.75rem;
      height: 5.75rem;
    }

    .author-card__button {
      width: 100%;
    }
  }
</style>
