# ==========================================
# Centinela 503 - Configuración de ejemplo
# ==========================================

# Aplicación
# Base de datos SQLite
DATABASE_URL=sqlite:///./data/centinela.db

# ESP32 / Puerto serial
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=115200
SERIAL_TIMEOUT=1

# Machine Learning
MODEL_PATH=./app/ml/artifacts/model.pkl
