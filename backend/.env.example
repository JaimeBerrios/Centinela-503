# ==========================================
# Centinela 503 - Configuración de ejemplo
# ==========================================

# Aplicación
APP_NAME=Centinela 503
APP_ENV=development
DEBUG=true

# API
API_HOST=127.0.0.1
API_PORT=8000

# Base de datos SQLite
DATABASE_PATH=./data/centinela503.db

# ESP32 / Puerto serial
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=115200
SERIAL_TIMEOUT=1

# Machine Learning
MODEL_PATH=./app/ml/artifacts/model.joblib
